# =============================================================
#  TumorOI - .gitignore
#  Models (.pth) and their metrics/plots ARE tracked.
#  Dataset images/masks are excluded (too large for GitHub).
# =============================================================

# -- Python ---------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# -- Virtual Environment --------------------------------------
venv/
.venv/
env/
.env/
ENV/

# -- Dataset (large binary files - use DVC or similar) --------
dataset/

# -- Jupyter / IPython ----------------------------------------
.ipynb_checkpoints/
*.ipynb

# -- OS artefacts ---------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# -- IDE / Editor ---------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -- Logs & temp files ----------------------------------------
*.log
*.tmp
*.temp

# -- Environment variables & secrets --------------------------
.env
.env.*
secrets.toml
.streamlit/secrets.toml


# -- Build artefacts ------------------------------------------
dist/
build/
*.egg-info/
*.egg

# =============================================================
#  EXPLICITLY TRACKED (do NOT ignore):
#    models/best_efficientnet_b0.pth
#    models/metrics.json
#    models/confusion_matrix.png
#    models/training_history.png
#    seg_models/best_unet_effb0.pth
#    seg_models/seg_metrics.json
#    seg_models/prediction_samples.png
#    seg_models/seg_training_history.png
#    .streamlit/config.toml
# =============================================================
